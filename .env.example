APP_NAME=Research AI
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Limites
MAX_QUERIES=12
MAX_PAGES=20
MAX_IMAGES=40
MAX_CYCLES=3
MAX_SEARCH_SECONDS=180
MAX_FILE_SIZE_MB=15
MAX_DOWNLOAD_SECONDS=20
REQUEST_TIMEOUT=20
MAX_CONTENT_LENGTH=2000000

# Provedores de busca
SEARXNG_URL=
SEARCH_PROVIDER=auto

# IA opcional (OpenAI-compatible)
AI_API_KEY=
AI_BASE_URL=https://opencode.ai/zen/go/v1
AI_MODEL=beam-free
AI_VISION_MODEL=
AI_TIMEOUT=60
AI_MAX_TOKENS=1200

# Cache
CACHE_TTL_HOURS=24
REUSE_CACHE=true

# Imagens
IMAGE_RELEVANCE_THRESHOLD=0.35
PHASH_DISTANCE_THRESHOLD=8

# Segurança
ALLOW_PRIVATE_NETWORKS=false
